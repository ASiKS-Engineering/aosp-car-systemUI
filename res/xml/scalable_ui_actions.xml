<?xml version="1.0" encoding="utf-8"?>
<Actions>

    <!--
         Enter fullscreen navigation mode.
    -->
    <Action id="global_navigation">
        <Broadcast action="com.example.campernavigator.action.NAVIGATION_UI_MODE_CHANGED">
            <Extra
                key="com.example.campernavigator.extra.NAVIGATION_UI_MODE"
                value="FULLSCREEN" />
        </Broadcast>
    </Action>

    <!--
         Existing navigation action.
    -->
    <Action id="com.android.systemui.car.intent.action.NAVIGATE">
        <Broadcast action="com.example.campernavigator.action.NAVIGATION_UI_MODE_CHANGED">
            <Extra
                key="com.example.campernavigator.extra.NAVIGATION_UI_MODE"
                value="FULLSCREEN" />
        </Broadcast>
    </Action>

    <!--
         Return to normal Home / Launcher mode.
    -->
    <Action id="global_home">
        <Broadcast action="com.example.campernavigator.action.NAVIGATION_UI_MODE_CHANGED">
            <Extra
                key="com.example.campernavigator.extra.NAVIGATION_UI_MODE"
                value="HOME" />
        </Broadcast>
    </Action>

</Actions>